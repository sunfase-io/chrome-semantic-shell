{
  "name": "chrome-semantic-shell",
  "version": "1.0.0",
  "description": "Local bridge and CLI for Chrome Semantic Shell",
  "main": "dist/index.js",
  "bin": {
    "chrome-shell-bridge": "./dist/cli.js",
    "chrome-shell": "./dist/semantic-cli.js"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,json --ignore dist/ --exec \"npm run build && npm run register:dev\"",
    "build": "ts-node src/scripts/build.ts",
    "test": "jest --runInBand --coverage=false",
    "test:coverage": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "shell:exec": "ts-node src/semantic-cli.ts",
    "register:dev": "node dist/scripts/register-dev.js",
    "postinstall": "node -e \"const fs=require('node:fs'),cp=require('node:child_process'),p='dist/scripts/postinstall.js';if(fs.existsSync(p))cp.execFileSync(process.execPath,[p],{stdio:'inherit'})\""
  },
  "files": [
    "dist",
    "!dist/node_path.txt"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "preferGlobal": true,
  "keywords": [
    "chrome",
    "browser",
    "semantic-shell",
    "cli"
  ],
  "author": "sunfase",
  "license": "MIT",
  "homepage": "https://github.com/sunfase-io/chrome-semantic-shell#readme",
  "bugs": {
    "url": "https://github.com/sunfase-io/chrome-semantic-shell/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunfase-io/chrome-semantic-shell.git",
    "directory": "app/native-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chrome-semantic-shell-shared": "workspace:*",
    "commander": "^13.1.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/chrome": "^0.0.318",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.31.1",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2"
  }
}
