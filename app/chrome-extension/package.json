{
  "name": "chrome-semantic-shell-extension",
  "description": "Headless Chrome runtime for the local Semantic Shell CLI",
  "author": "sunfase",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chrome-semantic-shell-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.318",
    "dotenv": "^16.5.0",
    "jsdom": "^26.0.0",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^2.1.8",
    "wxt": "^0.20.0"
  }
}
